# Groq API key (required for Groq Cloud transcription)
GROQ_API_KEY=

# Transcription language: tr, en, de, fr, es, it, auto
TRANSCRIPTION_LANGUAGE=tr

# Transcription provider: groq or local
TRANSCRIPTION_PROVIDER=groq

# Optional local faster-whisper settings (requires requirements-local.txt)
# Profiles: fast=base, balanced=small, quality=deepdml/faster-whisper-large-v3-turbo-ct2, high_quality=large-v3
LOCAL_WHISPER_PROFILE=balanced
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=auto
LOCAL_WHISPER_CPU_USAGE=normal
LOCAL_WHISPER_CPU_THREADS=4

# Audio feedback on start/stop
PLAY_BEEP_SOUND=true

# Copy transcript to clipboard automatically
AUTO_COPY=true

# Paste transcript with Ctrl+V after copying
AUTO_PASTE=true

# Paste Alt+R toggle recording transcript with Ctrl+V after copying
TOGGLE_RECORDING_AUTO_PASTE=false

# Opt-in FFmpeg-backed cleanup before transcription: off, normal, noisy, severe
AUDIO_CLEANUP_MODE=off
# Legacy compatibility; used only when AUDIO_CLEANUP_MODE is absent
AUDIO_CLEANUP_ENABLED=false
# Optional RNNoise model path. Select a trusted .rnnn model manually; the app copies it to managed app data.
AUDIO_CLEANUP_RNN_MODEL=

# Translate output to English instead of plain transcription
TRANSLATE_TO_EN=false

# Keep the app window above others
ALWAYS_ON_TOP=false

# Recording defaults
RECORDING_SAMPLE_RATE=16000
RECORDING_CHANNELS=1

# Saved recording mode preference: hold_to_talk or toggle
# Both PUSH_TO_TALK_KEY and DEFAULT_HOTKEY are active at runtime.
RECORDING_TRIGGER_MODE=hold_to_talk

# Hold-to-talk key
PUSH_TO_TALK_KEY=right_ctrl

# Minimum hold duration before recording starts
PUSH_TO_TALK_THRESHOLD_MS=150

# Toggle recording hotkey
DEFAULT_HOTKEY=<alt>+r

# Hotkey that toggles persistent Translate EN on/off
TRANSLATE_TOGGLE_HOTKEY=<shift>+t

# Input device index (-1 = system default microphone)
INPUT_DEVICE=-1
