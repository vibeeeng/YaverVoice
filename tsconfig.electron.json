{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "desktop/dist",
    "rootDir": "desktop"
  },
  "include": ["desktop/main/**/*.ts", "desktop/preload/**/*.ts"]
}
