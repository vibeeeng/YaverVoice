# Keep text files stable across Windows and Linux.
* text=auto eol=lf

# Windows command files are checked out with native Windows line endings.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.wav binary
*.mp3 binary
*.m4a binary
*.mp4 binary
*.pdf binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.bin binary
*.onnx binary
*.rnnn binary
